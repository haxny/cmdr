import LegalLayout from '../../layouts/LegalLayout.astro'
import DevTodo from '../../components/DevTodo.astro'
import { gapIssues } from '../../lib/accessibility-report'

const repo = 'https://github.com/vdavid/cmdr'
const issueUrl = (n: number) => `${repo}/issues/${n}`

// #443 is this page itself.
const gaps = gapIssues.filter((issue) => issue.number !== 443)

const toc = [
    { id: 'keyboard', label: 'Use Cmdr from the keyboard' },
    { id: 'screen-readers', label: 'Screen readers' },
    { id: 'seeing', label: 'Text size, zoom, and colors' },
    { id: 'motion', label: 'Motion and transparency' },
