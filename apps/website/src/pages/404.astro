---
/**
 * What nginx serves, with a real 404 status, for any URL with no page or file behind it
 * (`nginx.conf`'s `error_page 404`). Astro builds it to `/404.html`.
 */
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
---

<Layout title="Page not found | Cmdr" description="This page doesn't exist." noindex>
    <Header />
    <main class="mx-auto max-w-2xl px-6 pt-32 pb-24 text-center">
        <h1 class="mb-4 text-4xl font-bold tracking-tight text-text-primary">This page doesn't exist</h1>
        <p class="mb-8 text-lg text-text-secondary">
            The link may be old, or the address has a typo. Here are some places to go instead.
        </p>
        <nav aria-label="Popular pages" class="flex flex-wrap justify-center gap-x-6 gap-y-2">
            <a href="/" class="text-accent-text underline underline-offset-2 hover:text-accent-hover">Home</a>
            <a href="/features/" class="text-accent-text underline underline-offset-2 hover:text-accent-hover">Features</a>
            <a href="/pricing/" class="text-accent-text underline underline-offset-2 hover:text-accent-hover">Pricing</a>
            <a href="/blog/" class="text-accent-text underline underline-offset-2 hover:text-accent-hover">Blog</a>
        </nav>
    </main>
    <Footer />
</Layout>
