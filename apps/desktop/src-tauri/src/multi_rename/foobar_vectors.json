    { "pattern": "$upper('a)", "error": { "type": "unclosed", "what": "quote", "at": 7 } },
    { "pattern": "$upper(a (b", "error": { "type": "unclosed", "what": "parenthesis", "at": 9 } },
    { "pattern": "$upper(a (b (c) d", "error": { "type": "unclosed", "what": "parenthesis", "at": 9 } },
    { "pattern": "$if(a,x (y,z)", "error": { "type": "unclosed", "what": "function", "at": 0 } },
